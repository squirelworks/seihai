+// Lab-only. 5.12 steps a zlib or bz2 body once per whole 4-byte group
+// (len/4, rounded down) and leaves a partial last group as it is.
+void CEncryption::roundDownLimit(int32_t len)
+{
+	if (!m_roundDown || !m_compressed) return;
+	int32_t groups = len / 4;
+	if (m_limit < 0 || groups < m_limit) m_limit = groups;
+}
